# TCP port for Concox GPS devices
CONCOX_PORT=5027

# HTTP API port (standalone concox-logger / concox-server CLI only)
API_PORT=3000

# File logging: daily concox-YYYY-MM-DD.log under LOG_DIR (relative to process.cwd())
CONCOX_FILE_LOGGING=true
LOG_DIR=./logs
CONCOX_LOG_TO_CONSOLE=true
CONCOX_LOG_RETENTION_DAYS=7
